PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vila_waitlist
CLIENT_ORIGIN=http://localhost:3000
NODE_ENV=development
TRUSTED_PROXY_IPS=loopback

# SMTP (Gmail uses a Google App Password, not your regular account password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youraddress@gmail.com
EMAIL_PASS=replace-with-your-smtp-app-password
# Optional: authenticated sender display name and address
EMAIL_FROM="VILA <youraddress@gmail.com>"

# Absolute public URL in links inside emails. Set to the real deployed website in production.
PUBLIC_APP_URL=http://localhost:3000
